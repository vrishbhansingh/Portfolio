# Copy this file to .env.local (same folder) and fill it in.
# .env.local is git-ignored, so your password never gets committed.
# Restart `npm run dev` after editing.

# --- SMTP server ---
# Gmail:      smtp.gmail.com, port 465 (or 587). Use an App Password, not your normal password:
#             Google Account > Security > 2-Step Verification > App passwords
# Hostinger:  smtp.hostinger.com, port 465
# Zoho:       smtp.zoho.in, port 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465, false for 587 (optional; worked out from the port if left empty)
SMTP_SECURE=
SMTP_USER=you@gmail.com
SMTP_PASS=

# --- Where form messages go ---
CONTACT_TO_EMAIL=vrishbhansingh321@gmail.com
# Optional sender line. Leave empty to send from SMTP_USER.
CONTACT_FROM_EMAIL=
